# Copy to .env (never commit .env).

# Overwolf Dev Mode credentials: Developer Console > Settings > Profile > API key.
OW_CLI_EMAIL=
OW_CLI_API_KEY=

# apexlegendsstatus.com API key (https://apexlegendsapi.com/). Leave empty to skip RP snapshots.
APEX_STATUS_API_KEY=

# Optional: where recordings go. Default: Documents\ApexTracker
# APEX_TRACKER_DATA_DIR=
