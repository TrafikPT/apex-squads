# Copy to .env (never commit .env).

# Overwolf Dev Mode: the Developer Key from your dev.overwolf.com profile (approved
# developers only). Expires every 14 days; extend it there.
OW_DEV_KEY=

# Or the Developer Console pair (Settings > Profile > API key). If set, these win over
# OW_DEV_KEY, so leave them commented out when using the key above.
# OW_CLI_EMAIL=
# OW_CLI_API_KEY=

# apexlegendsstatus.com API key (https://apexlegendsapi.com/). Leave empty to skip RP snapshots
# and the ranks in kill/death popups.
APEX_STATUS_API_KEY=

# Optional: where recordings go. Default: %APPDATA%\Apex Squads
# APEX_SQUADS_DATA_DIR=
